# --- upstream llm ---
# куда прокси стучится если кэш промахнулся
# можно указать openai, anthropic-compatible, локальную vllm и тд
UPSTREAM_API_URL=https://api.openai.com/v1/chat/completions
UPSTREAM_API_KEY=sk-xxxx
UPSTREAM_MODEL=gpt-4o-mini

# --- cache ---
SIMILARITY_THRESHOLD=0.93
CACHE_TTL_SECONDS=604800  # 7 дней
MAX_CACHE_SIZE=10000
VECTOR_BACKEND=memory  # memory | pgvector | redis
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
USE_ONNX=false

# --- pricing для дашборда (сколько экономим) ---
# цены за 1k токенов, баксы
PRICE_INPUT_PER_1K=0.005
PRICE_OUTPUT_PER_1K=0.015

# --- postgres (если VECTOR_BACKEND=pgvector) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/semantic_cache

# --- redis (если VECTOR_BACKEND=redis) ---
REDIS_URL=redis://redis:6379/0

# --- app ---
APP_PORT=8000
LOG_LEVEL=info
